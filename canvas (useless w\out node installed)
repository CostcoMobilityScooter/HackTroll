import { useEffect } from "react";

export default function HackerScreen() {
  useEffect(() => {
    const content = document.getElementById('content');

    const hackerWords = [
      'ACCESS GRANTED',
      'ACCESS DENIED',
      'SYSTEM OVERRIDE',
      'TRACKING IP',
      'BYPASSING FIREWALL',
      'DECRYPTING FILES',
      'MAINFRAME ACCESS',
      'SECURITY BREACH',
      'PASSWORD CRACKED',
      'ROOT ACCESS ENABLED',
      'SCANNING NETWORK',
      'LOCATING TARGET'
    ];

    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%^&*<>[]{}';

    const fakeCommands = [
      'sudo rm -rf /',
      'nmap 192.168.0.1',
      'ssh root@mainframe',
      'decrypt --all',
      'locate passwords.txt',
      'ping FBI.gov',
      './breach_firewall.sh',
      'cat classified.txt'
    ];

    let output = '';
    let running = true;

    function randomChar() {
      return chars[Math.floor(Math.random() * chars.length)];
    }

    function randomWord() {
      return hackerWords[Math.floor(Math.random() * hackerWords.length)];
    }

    function randomCommand() {
      return fakeCommands[Math.floor(Math.random() * fakeCommands.length)];
    }

    function type() {
      if (!running) return;

      let action = Math.random();

      if (action < 0.08) {
        const prompts = [
          'root@kali:/# ',
          'user@ubuntu:~$ ',
          'admin@server:/var/log$ ',
          'guest@matrix:~$ ',
          'sysop@mainframe:/usr/bin# '
        ];

        const prompt = prompts[
          Math.floor(Math.random() * prompts.length)
        ];

        output += '\n' + prompt + randomCommand() + '\n';
      } else if (action < 0.14) {
        output += ' ' + randomWord() + ' ';
      } else {
        let burst = Math.floor(Math.random() * 5) + 1;

        for (let i = 0; i < burst; i++) {
          output += randomChar();
        }
      }

      content.innerHTML = output + '<span class="animate-pulse">█</span>';
      content.scrollTop = content.scrollHeight;

      if (output.length > 40000) {
        output = '';
      }
    }

    function handleKeyPress() {
      const presses = Math.floor(Math.random() * 5) + 1;

      for (let i = 0; i < presses; i++) {
        type();
      }
    }

    window.addEventListener('keydown', handleKeyPress);

    return () => {
      running = false;
      window.removeEventListener('keydown', handleKeyPress);
    };
  }, []);

  return (
    <div className="h-screen bg-black text-green-400 font-mono overflow-hidden flex items-center justify-center relative before:absolute before:inset-0 before:bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px)] before:bg-[size:100%_4px]">
      

      <div
        id="terminal"
        className="relative z-10 w-[900px] h-[80vh] bg-[#0c0c0c] rounded-xl overflow-hidden border border-zinc-700 shadow-2xl animate-pulse"
      >
        <div className="h-10 bg-[#1e1e1e] flex items-center px-4 border-b border-zinc-700">
          <div className="flex gap-2">
            <div className="w-3 h-3 rounded-full bg-red-500"></div>
            <div className="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div className="w-3 h-3 rounded-full bg-green-500"></div>
          </div>

          <div className="absolute left-1/2 -translate-x-1/2 text-zinc-400 text-sm">
            user@ubuntu: ~
          </div>
        </div>

        <div className="p-4 h-[calc(100%-40px)] overflow-hidden">
          <div className="text-green-400 text-sm mb-2">
            user@ubuntu:~$ ./mainframe_access.sh
          </div>

          <div className="absolute inset-0 pointer-events-none opacity-5 bg-white"></div>

          <div
            id="content"
            className="h-full overflow-hidden whitespace-pre-wrap break-words text-sm leading-6 text-green-400"
          ></div>
        </div>
      </div>

      

      
    </div>
  );
}

